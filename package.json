{
  "name": "@novice1/frame",
  "version": "0.5.0",
  "description": "Web framework for building APIs.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kisiwu/novice-frame.git"
  },
  "scripts": {
    "build": "npm run lint && tsc",
    "doc": "typedoc",
    "format": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --write .",
    "format:check": "cross-env NODE_OPTIONS=--experimental-strip-types prettier --check .",
    "lint": "eslint .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "api",
    "framework",
    "openapi",
    "novice1",
    "postman",
    "express"
  ],
  "author": "demingongo",
  "license": "MIT",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/extend": "^3.0.4",
    "@types/node": "^26.6.6",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.10.0",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "@novice1/routing": "^2.1.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "@types/express": {
      "optional": true
    }
  },
  "dependencies": {
    "@novice1/api-doc-generator": "^2.0.1",
    "@novice1/app": "^0.9.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "extend": "^3.0.2",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.9.1",
    "yamljs": "^0.3.0"
  }
}
